type hal_fingerprint_oppo, domain;
type hal_fingerprint_oppo_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_fingerprint_oppo)
hal_server_domain(hal_fingerprint_oppo, hal_fingerprint)
binder_call(hal_fingerprint_oppo, hal_fingerprint_default)
allow hal_fingerprint_oppo fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_oppo tee_device:chr_file rw_file_perms;
allow hal_fingerprint_oppo uhid_device:chr_file rw_file_perms;
allow hal_fingerprint_oppo self:netlink_socket create_socket_perms_no_ioctl;
r_dir_file(hal_fingerprint_oppo, firmware_file)
allow hal_fingerprint_oppo proc_oppo_fp_id:file rw_file_perms;
allow hal_fingerprint_oppo proc_touchpanel:dir r_dir_perms;
allow hal_fingerprint_oppo proc_touchpanel:file rw_file_perms;
allow hal_fingerprint_oppo sysfs_fingerprint:dir r_dir_perms;
allow hal_fingerprint_oppo sysfs_fingerprint:file r_file_perms;
get_prop(hal_fingerprint_oppo, oppo_fingerprint_prop)
set_prop(hal_fingerprint_oppo, oppo_fingerprint_prop)
