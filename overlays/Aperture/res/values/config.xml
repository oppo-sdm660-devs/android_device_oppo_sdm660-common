<!-- Video quality set comes from media_profiles_vendor.xml, not here. -->
<resources>
    <!-- Android Camera Extensions are not provided by this port. -->

    <bool name="config_enableAuxCameras">true</bool>

    <!-- Hide the duplicate/internally paired rear camera ids 3 and 4. -->
    <string-array name="config_ignoredAuxCameraIds">
        <item>3</item>
        <item>4</item>
    </string-array>
</resources>
